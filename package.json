  "type": "module",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=26.12.1 <27",
    "npm": ">=12.2.1 <13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=low",
    "unit:test": "node --test tests/*.test.ts",
    "test:unit": "vitest run",
    "security:test": "node --test scripts/check-browser-security.test.mjs",
    "security:source": "node scripts/check-browser-security.mjs source",
    "security:dist": "node scripts/check-browser-security.mjs dist",
    "verify:dist": "node scripts/check-production-build.mjs",
    "browser:verification:test": "node scripts/check-verification-result-browser.mjs",
    "test": "npm run audit && npm run lint && npm run unit:test && npm run test:unit && npm run security:test && npm run security:source && npm run build && npm run verify:dist && npm run security:dist && npm run browser:verification:test",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
